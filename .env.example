# ============================================================================
# authentik 项目 env 模板（部署平台的项目 env / .env 用）
# 上游没有官方 .env.example，本文件由 authentik 分支手工维护（不是 bot 同步）。
# 用法：把需要的行填好值，配进部署平台的项目 env；值永远不进 git。
# ============================================================================

# ---------- 必填（上游 compose 有 :? 断言，不设直接拒绝启动）----------

# postgresql 超级用户密码。生成：openssl rand -hex 32
PG_PASS=

# authentik 加密密钥（session/凭据加密），丢失 = 所有加密数据不可解，务必备份。
# 生成（官方推荐）：openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=

# ---------- 可选：数据库（默认都是 authentik，一般不用动）----------

# PG_DB=authentik
# PG_USER=authentik

# ---------- 可选：全局 SMTP（找回密码/通知邮件）----------
# 全局 SMTP 在管理界面没有设置页，只能 env 配置（官方口径）；
# override 已对 server/worker 做透传，在这里填值即可生效。
# TLS 模式（照邮件服务商文档二选一，绝不能同时开）：
#   587 端口 STARTTLS：USE_TLS=true,  USE_SSL=false
#   465 端口 SSL：     USE_SSL=true,  USE_TLS=false
AUTHENTIK_EMAIL__HOST=
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__TIMEOUT=10
AUTHENTIK_EMAIL__FROM=authentik@savorcare.com

# ---------- 可选：错误上报（官方建议开，帮助上游改进）----------

# AUTHENTIK_ERROR_REPORTING__ENABLED=true

# ---------- 配好 SMTP 后验证（在 docker1 上项目目录里执行）----------
# docker compose exec worker ak test_email 你的邮箱@example.com
