<mxfile host="app.diagrams.net" agent="netbird-compose" version="24.0.0">
  <diagram name="final-architecture" id="nb-final-arch">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= 外部区 ================= -->
        <mxCell id="zone-ext" value="外部" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;fontSize=13;fontColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="400" height="240" as="geometry" />
        </mxCell>
        <mxCell id="ext-peer" value="&lt;b&gt;外部 peer&lt;/b&gt;&lt;br/&gt;员工/agent 设备（装 NetBird 客户端）&lt;br/&gt;管理 URL: https://netbird.savorcare.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ext-guest" value="&lt;b&gt;访客浏览器&lt;/b&gt;&lt;br/&gt;（不装客户端）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dns-note" value="公网 DNS（Namecheap）&lt;br/&gt;netbird → &lt;b&gt;oraclejp&lt;/b&gt; 140.83.87.53&lt;br/&gt;*.netbird → &lt;b&gt;oraclejp&lt;/b&gt;&lt;br/&gt;relay.netbird → &lt;b&gt;公司 IP&lt;/b&gt;&lt;br/&gt;qhxxg → &lt;b&gt;公司 IP&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="240" height="90" as="geometry" />
        </mxCell>

        <!-- ================= oraclejp ================= -->
        <mxCell id="zone-vps" value="oraclejp（VPS，日本·双栈）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;dashed=1;verticalAlign=top;fontSize=13;fontColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="460" y="20" width="420" height="280" as="geometry" />
        </mxCell>
        <mxCell id="xray" value="Xray :443（REALITY 主站）&lt;br/&gt;非 REALITY SNI → 回落 Caddy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="480" y="55" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="caddy" value="&lt;b&gt;Caddy :8003&lt;/b&gt;&lt;br/&gt;真证书（OPNSense ACME 同步）&lt;br/&gt;① netbird.savorcare.com&lt;br/&gt;   → 反代 公司:10443（h2c, SNI 校验）&lt;br/&gt;② *.netbird.savorcare.com&lt;br/&gt;   → 反代 127.0.0.1:8444" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="480" y="125" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="pubproxy" value="&lt;b&gt;netbird 公网 proxy&lt;/b&gt;&lt;br/&gt;（Arcane 项目 netbird-proxy）&lt;br/&gt;127.0.0.1:8444 ← Caddy&lt;br/&gt;管理面连接: qhxxg:10443&lt;br/&gt;（直连公司，不绕 Caddy 管理链）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="480" y="260" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- ================= 公司边界 ================= -->
        <mxCell id="zone-edge" value="公司边界 · OPNSense（静态 IP 183.238.250.166；443/80/8443 被 ISP 封）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;dashed=1;verticalAlign=top;fontSize=12;fontColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="920" y="20" width="310" height="120" as="geometry" />
        </mxCell>
        <mxCell id="edge-nat" value="端口映射（WAN → docker1）&lt;br/&gt;TCP 10443 → 443（管理面）&lt;br/&gt;TCP+UDP 9443 → 9443（relay）&lt;br/&gt;UDP 3479 → 3479（STUN）&lt;br/&gt;UDP 51821 → 51821（proxy WG，可选）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="940" y="55" width="270" height="80" as="geometry" />
        </mxCell>

        <!-- ================= docker1 ================= -->
        <mxCell id="zone-d1" value="docker1（内网 192.168.254.51，控制面归属地）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;fontSize=13;fontColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="920" y="160" width="310" height="300" as="geometry" />
        </mxCell>
        <mxCell id="server" value="&lt;b&gt;netbird-server&lt;/b&gt;&lt;br/&gt;management+signal（443 经 traefik）&lt;br/&gt;stuns/relays 块已配（3479/9443）&lt;br/&gt;ProxyService 路由已补" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="940" y="195" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="traefik" value="docker1 traefik :443（固定证书）&lt;br/&gt;Host(netbird.savorcare.com) 路由" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="940" y="275" width="270" height="45" as="geometry" />
        </mxCell>
        <mxCell id="relay" value="&lt;b&gt;relay 容器&lt;/b&gt; :9443 tcp+udp, STUN :3479" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="940" y="330" width="270" height="40" as="geometry" />
        </mxCell>
        <mxCell id="agentproxy" value="&lt;b&gt;proxy 私有实例&lt;/b&gt;（agent network）&lt;br/&gt;WG overlay 内, 51821/udp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="940" y="378" width="270" height="45" as="geometry" />
        </mxCell>

        <!-- ================= 内网 ================= -->
        <mxCell id="zone-lan" value="公司内网（split-horizon：netbird.savorcare.com → docker1 直连，永不依赖外网）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;fontSize=12;fontColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="20" y="330" width="400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="int-peer" value="&lt;b&gt;内网 peer&lt;/b&gt;&lt;br/&gt;管理 URL 无端口（内网 DNS → docker1:443）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="vlan" value="&lt;b&gt;各 VLAN 资源&lt;/b&gt;&lt;br/&gt;OPNSense = routing peer&lt;br/&gt;Networks + ACL 管控" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- ============ 流量箭头 ============ -->
        <mxCell id="f1" value="① 管理面 gRPC（管理+signal+注册）&lt;br/&gt;443 无端口" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5" edge="1" parent="1" source="ext-peer" target="caddy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f1b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2" edge="1" parent="1" source="caddy" target="traefik">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="185" />
              <mxPoint x="700" y="297" />
              <mxPoint x="900" y="297" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="f1c" value="Caddy→公司:10443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=1;fontSize=9;dashed=1" edge="1" parent="1" source="caddy" target="edge-nat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="② 访客 HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1" source="ext-guest" target="caddy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2b" value="Caddy→127.0.0.1:8444" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=1;fontSize=9;dashed=1" edge="1" parent="1" source="caddy" target="pubproxy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="③ proxy 注册/映射流&lt;br/&gt;直连 qhxxg:10443（绕本机 Caddy）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;dashed=1;labelBackgroundColor=#ffffff" edge="1" parent="1" source="pubproxy" target="server">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="④ STUN/relay&lt;br/&gt;3479/udp · 9443 tcp/udp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1" source="ext-peer" target="relay">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="⑤ WG P2P" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;dashed=1;strokeWidth=2;fontSize=10" edge="1" parent="1" source="ext-peer" target="opn-ref" style2="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="opn-ref" value="OPNSense（routing peer）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="960" y="490" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10" edge="1" parent="1" source="opn-ref" target="vlan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
