<mxfile host="app.diagrams.net" agent="netbird-compose" version="24.0.0">
  <diagram name="target-architecture" id="nb-target-arch">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 外部用户 -->
        <mxCell id="ext-peer" value="&lt;b&gt;外部 peer（员工/agent）&lt;/b&gt;&lt;br/&gt;URL: https://netbird.savorcare.com&lt;br/&gt;（无端口，内外网一致）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="30" y="40" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ext-guest" value="&lt;b&gt;访客浏览器（免客户端）&lt;/b&gt;&lt;br/&gt;https://&amp;lt;服务&amp;gt;.netbird.savorcare.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="30" y="150" width="230" height="55" as="geometry" />
        </mxCell>

        <!-- oraclejp -->
        <mxCell id="zone-vps" value="oraclejp（VPS 入口，仅 L4 转发 + 访客终结，不处理 gRPC）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;dashed=1;verticalAlign=top;fontSize=12;fontColor=#b09030" vertex="1" parent="1">
          <mxGeometry x="330" y="20" width="440" height="330" as="geometry" />
        </mxCell>
        <mxCell id="sni-router" value="&lt;b&gt;L4 SNI 路由器 :443&lt;/b&gt;（nginx stream / Xray dokodemo）&lt;br/&gt;按 TLS ClientHello SNI 分流，纯 TCP 透传不终结：&lt;br/&gt;① netbird.savorcare.com → 公司:10443（管理面，端到端 TLS 到 docker1）&lt;br/&gt;② *.netbird.savorcare.com → Caddy:8003（访客）&lt;br/&gt;③ 其余/REALITY → Xray 本机端口（现有业务不变）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="350" y="50" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="xray" value="Xray REALITY（本机端口，现有）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="350" y="160" width="190" height="40" as="geometry" />
        </mxCell>
        <mxCell id="caddy" value="&lt;b&gt;Caddy :8003&lt;/b&gt;（现有）&lt;br/&gt;通配证书终结 → 127.0.0.1:8444" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="350" y="215" width="190" height="55" as="geometry" />
        </mxCell>
        <mxCell id="pubproxy" value="&lt;b&gt;公网 proxy&lt;/b&gt;（访客入口）&lt;br/&gt;→ WG → 内网 peer&lt;br/&gt;管理面: netbird.savorcare.com:443（经 SNI 透传）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="350" y="285" width="190" height="55" as="geometry" />
        </mxCell>

        <!-- 公司边界 -->
        <mxCell id="zone-edge" value="公司边界 OPNSense（静态 IP，443/80 被 ISP 封）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;fontSize=12;fontColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="820" y="20" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="nat" value="WAN 映射 → docker1：TCP 10443→443（管理面）｜TCP+UDP 9443（relay）｜UDP 3479（STUN）｜UDP 51821（agent proxy，可选）&lt;br/&gt;WAN 放行 → OPNSense 自身：UDP 51820（routing peer P2P）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="840" y="50" width="380" height="55" as="geometry" />
        </mxCell>

        <!-- docker1 -->
        <mxCell id="zone-d1" value="docker1（内网控制面，192.168.254.51）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;fontSize=12;fontColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="820" y="140" width="420" height="190" as="geometry" />
        </mxCell>
        <mxCell id="traefik" value="traefik :443（通配固定证书，TLS 终点）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="840" y="170" width="180" height="35" as="geometry" />
        </mxCell>
        <mxCell id="server" value="&lt;b&gt;netbird-server&lt;/b&gt;（management+signal+dashboard）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="1040" y="170" width="180" height="35" as="geometry" />
        </mxCell>
        <mxCell id="relay" value="&lt;b&gt;relay+STUN&lt;/b&gt; 9443 tcp/udp · 3479/udp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="840" y="220" width="180" height="35" as="geometry" />
        </mxCell>
        <mxCell id="privproxy" value="&lt;b&gt;私有 proxy&lt;/b&gt;（agent network，overlay only）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="1040" y="220" width="180" height="35" as="geometry" />
        </mxCell>

        <!-- 内网 -->
        <mxCell id="zone-lan" value="公司内网（split-horizon DNS）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;fontSize=12;fontColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="30" y="360" width="740" height="130" as="geometry" />
        </mxCell>
        <mxCell id="int-peer" value="&lt;b&gt;内网 peer&lt;/b&gt;&lt;br/&gt;URL: https://netbird.savorcare.com（内网 DNS → docker1:443 直连）&lt;br/&gt;断外网时管理面仍 100% 可用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="50" y="395" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="opn" value="&lt;b&gt;OPNSense&lt;/b&gt;（routing peer，WG 51820）&lt;br/&gt;Networks 发布 VLAN 网段 + ACL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="400" y="395" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="vlan" value="&lt;b&gt;VLAN 资源&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=10;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="660" y="395" width="90" height="60" as="geometry" />
        </mxCell>

        <!-- DNS 表 -->
        <mxCell id="dns" value="&lt;b&gt;DNS 设计（统一域名关键）&lt;/b&gt;&lt;br/&gt;公网：netbird→oraclejp｜*.netbird→oraclejp｜relay.netbird→公司IP｜qhxxg→公司IP&lt;br/&gt;内网：netbird→docker1｜relay.netbird→docker1&lt;br/&gt;（同一域名两边都通，端口全隐含，客户端配置内外零差异）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="30" y="520" width="520" height="75" as="geometry" />
        </mxCell>

        <!-- 流量模式 -->
        <mxCell id="modes" value="&lt;b&gt;五种流量模式&lt;/b&gt;&lt;br/&gt;① 管理面（外部）：peer→oraclejp:443→[L4透传]→公司:10443→traefik→server（TLS 端到端，无 HTTP 中间件）&lt;br/&gt;② 管理面（内网）：peer→docker1:443 直连&lt;br/&gt;③ 数据面 P2P：peer↔peer 直连（STUN 打洞；OPNSense 51820 + docker1 51821 可映射提升成功率）&lt;br/&gt;④ 数据面 relay：打洞失败→公司 relay:9443（QUIC 优先），不经 VPS&lt;br/&gt;⑤ 访客：browser→oraclejp:443→Caddy→公网 proxy→WG→内网 peer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="30" y="620" width="760" height="100" as="geometry" />
        </mxCell>

        <!-- 边 -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2" edge="1" parent="1" source="ext-peer" target="sni-router">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=2" edge="1" parent="1" source="ext-guest" target="sni-router">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="① 管理面 TCP 透传" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=9;labelBackgroundColor=#ffffff" edge="1" parent="1" source="sni-router" target="traefik">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=1.5;dashed=1" edge="1" parent="1" source="sni-router" target="caddy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;dashed=1" edge="1" parent="1" source="sni-router" target="xray">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6" edge="1" parent="1" source="caddy" target="pubproxy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1" edge="1" parent="1" source="traefik" target="server">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="④ relay（不经 VPS）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=9;labelBackgroundColor=#ffffff" edge="1" parent="1" source="ext-peer" target="nat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366" edge="1" parent="1" source="nat" target="relay">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="③ P2P" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;dashed=1;strokeWidth=2;fontSize=9;labelBackgroundColor=#ffffff" edge="1" parent="1" source="ext-peer" target="opn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1" edge="1" parent="1" source="opn" target="vlan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="② 内网直连" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;fontSize=9" edge="1" parent="1" source="int-peer" target="traefik">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="⑤ WG→peer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;dashed=1;fontSize=9" edge="1" parent="1" source="pubproxy" target="opn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
